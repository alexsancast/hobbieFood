<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="fiscal_info">
        <t t-set="ecf_representation" t-value="o.fiscal_type_id.prefix.startswith('E')"/>
        <div class="col-6 first-page" style="align-self: flex-start;">
            <h3 t-if="o.fiscal_type_id" style="font-size: 18px; font-weight: bold;">
                <t t-if="o.fiscal_type_id.prefix in ('B13', 'B03', 'B04', 'E33', 'E34')">
                    <span t-field="o.fiscal_type_id.name"/>
                </t>
                <t t-else="">
                    Factura de <span t-field="o.fiscal_type_id.name"/>
                </t>
            </h3>
            <div t-if="o.ref">
                <strong>
                    <t t-if="ecf_representation">e-NCF:</t>
                    <t t-else="">NCF:</t>
                </strong>
                <span t-field="o.ref"/>
            </div>
            <div t-if="o.origin_out">
                <strong t-if="o.origin_out.startswith('E')">e-NCF modificado:</strong>
                <strong t-else="">NCF modificado:</strong>
                <span t-field="o.origin_out"/>
            </div>
            <div id="fiscal_exp_date"
                t-if="o.state == 'posted'
                    and o.ref
                    and o.fiscal_type_id
                    and o.fiscal_type_id.prefix not in ('B02', 'B03', 'B04', 'E33', 'E34')
                    and o.ncf_expiration_date">
                <strong>
                    <t t-if="ecf_representation">Expiración e-NCF:</t>
                    <t t-else="">Válido hasta:</t>
                </strong>
                <span t-field="o.ncf_expiration_date"/>
            </div>
        </div>
    </template>

    <template id="fiscal_info_header">
        <t t-set="ecf_representation" t-value="o.fiscal_type_id.prefix.startswith('E')"/>
        <div style="text-align: center; white-space: nowrap;">
            <h3 t-if="o.fiscal_type_id" style="font-size: 18px; font-weight: bold; white-space: nowrap; margin: 0 0 4px 0;">
                <t t-if="o.fiscal_type_id.prefix in ('B13', 'B03', 'B04', 'E33', 'E34')">
                    <span t-field="o.fiscal_type_id.name"/>
                </t>
                <t t-else="">
                    Factura de <span t-field="o.fiscal_type_id.name"/>
                </t>
            </h3>
            <div t-if="o.ref">
                <strong>
                    <t t-if="ecf_representation">e-NCF:</t>
                    <t t-else="">NCF:</t>
                </strong>
                <span t-field="o.ref"/>
            </div>
            <div t-if="o.origin_out">
                <strong t-if="o.origin_out.startswith('E')">e-NCF modificado:</strong>
                <strong t-else="">NCF modificado:</strong>
                <span t-field="o.origin_out"/>
            </div>
            <div id="fiscal_exp_date"
                t-if="o.state == 'posted'
                    and o.ref
                    and o.fiscal_type_id
                    and o.fiscal_type_id.prefix not in ('B02', 'B03', 'B04', 'E33', 'E34')
                    and o.ncf_expiration_date">
                <strong>
                    <t t-if="ecf_representation">Expiración e-NCF:</t>
                    <t t-else="">Válido hasta:</t>
                </strong>
                <span t-field="o.ncf_expiration_date"/>
            </div>
        </div>
    </template>

    <template id="complete_fiscal_info">
        <div class="row pt-2 mb8 first-page">
            <div class="col-6" name="company_address">
                <div t-if="company.is_company_details_empty">
                    <strong><t t-esc="company.name"/></strong>
                    <t t-esc="company.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                </div>
                <div t-else="">
                    <t t-esc="company.company_details"/>
                </div>
                <div t-if="forced_vat">
                    <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                    <span t-esc="forced_vat"/>
                </div>
            </div>
            <t t-call="l10n_do_accounting.fiscal_info"/>
        </div>
    </template>

    <template id="external_layout_standard_inherited" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('d-flex')][hasclass('justify-content-between')]" position="replace">
            <t t-if="l10n_do_fiscal_invoice">
                <table style="width: 100%; margin-bottom: 8px;">
                    <tr>
                        <td style="vertical-align: top;">
                            <img t-if="company.logo" class="o_company_logo_small" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                            <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline mw-50 fw-bold">Company tagline</div>
                        </td>
                        <td class="l10n_do_fiscal_header" style="vertical-align: top; text-align: right;">
                            <style>
                                .l10n_do_fiscal_header .col-6 { width: 100%; padding: 0; margin: 0; }
                            </style>
                            <t t-call="l10n_do_accounting.fiscal_info"/>
                        </td>
                    </tr>
                </table>
            </t>
            <t t-else="">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <img t-if="company.logo" class="o_company_logo_small" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                    <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline mw-50 fw-bold">Company tagline</div>
                </div>
            </t>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']/li[@t-else='']" position="after">
            <t t-if="l10n_do_fiscal_invoice">
                <li t-if="not forced_vat and company.vat" class="first-page">
                    <strong>
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="company_inv_tax_id_label"/>
                    <t t-else="">Tax ID</t>: </strong><span t-field="o.company_id.vat"/>
                </li>
                <li t-if="o.invoice_date" class="first-page">
                    <strong>Date:</strong> <span t-field="o.invoice_date"/>
                </li>
            </t>
        </xpath>
    </template>

    <template id="external_layout_boxed_inherited" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not l10n_do_fiscal_invoice</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <t t-if="l10n_do_fiscal_invoice">
                <div name="company_fiscal_info_header" style="float: right; margin-right: 25px;">
                    <t t-call="l10n_do_accounting.fiscal_info_header"/>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'article')]/*[1]" position="before">
            <t t-if="l10n_do_fiscal_invoice">
                <div class="row mb8 first-page">
                    <div class="col-6" name="company_address">
                        <style>
                            #l10n_do_company_address p { margin: 0; }
                        </style>
                        <div id="l10n_do_company_address">
                            <div t-if="company.is_company_details_empty">
                                <strong><t t-esc="company.name"/></strong>
                                <t t-esc="company.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                            </div>
                            <div t-else="">
                                <t t-esc="company.company_details"/>
                            </div>
                            <div t-if="forced_vat">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-esc="forced_vat"/>
                            </div>
                            <div t-if="not forced_vat and company.vat">
                                <strong>
                                    <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                                    <t t-else="">RNC</t>: </strong><span t-field="o.company_id.vat"/>
                            </div>
                        </div>
                    </div>
                    <!-- Número de factura: ocupa la posición donde antes estaba "Cliente" -->
                    <div class="col-6" style="text-align: right;">
                        <h2 t-if="o.name and o.name != '/'" t-field="o.name" style="margin: 0;"/>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- "Cliente"/"Proveedor": ocupa la posición donde antes estaba el número de factura (h2 del core) -->
        <xpath expr="//h2[@t-out='layout_document_title']" position="replace">
            <t t-if="l10n_do_fiscal_invoice">
                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="row mb-4 first-page">
                        <div class="col-6" name="fiscal_address_not_same_as_shipping">
                            <t t-call="l10n_do_accounting.receiver_fiscal_info"/>
                        </div>
                        <div class="col-6">
                            <div groups="account.group_delivery_invoice_address">
                                <strong>Shipping Address:</strong>
                                <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="row mb-4 first-page">
                        <div class="col-6" name="fiscal_no_shipping">
                            <t t-call="l10n_do_accounting.receiver_fiscal_info"/>
                        </div>
                    </div>
                </t>
            </t>
            <t t-else="">
                <h2 t-out="layout_document_title"/>
            </t>
        </xpath>
    </template>

    <template id="external_layout_bold_inherited" inherit_id="web.external_layout_bold">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not l10n_do_fiscal_invoice</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <div class="col-5 offset-1 not-first-page" name="company_address" t-if="l10n_do_fiscal_invoice">
                <ul class="list-unstyled">
                    <li t-if="company.is_company_details_empty"><t t-esc="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                    <li t-else=""><t t-esc="company.company_details"/></li>
                    <li t-if="forced_vat">
                        <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                        <span t-esc="forced_vat"/>
                    </li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'article')]/*[1]" position="before">
            <t t-if="l10n_do_fiscal_invoice">
                <t t-call="l10n_do_accounting.complete_fiscal_info"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.address_layout']" position="replace">
            <t t-if="l10n_do_fiscal_invoice">
                <div class="pt-5">
                    <t t-call="web.address_layout"/>
                </div>
            </t>
            <t t-else="">
                <t t-call="web.address_layout"/>
            </t>
        </xpath>
    </template>

    <template id="external_layout_striped_inherited" inherit_id="web.external_layout_striped">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not l10n_do_fiscal_invoice</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <div class="float-start company_address not-first-page" t-if="l10n_do_fiscal_invoice">
                <ul class="list-unstyled">
                    <li t-if="company.is_company_details_empty"><t t-esc="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                    <li t-else=""><t t-esc="company.company_details"/></li>
                    <li t-if="forced_vat">
                        <t t-esc="company.country_id.vat_label or 'Tax ID'"/>:
                        <span t-esc="forced_vat"/>
                    </li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'article')]/*[1]" position="before">
            <t t-if="l10n_do_fiscal_invoice">
                <t t-call="l10n_do_accounting.complete_fiscal_info"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.address_layout']" position="replace">
            <t t-if="l10n_do_fiscal_invoice">
                <div class="pt-5">
                    <t t-call="web.address_layout"/>
                </div>
            </t>
            <t t-else="">
                <t t-call="web.address_layout"/>
            </t>
        </xpath>
    </template>

    <template id="external_layout_bubble_inherited" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not l10n_do_fiscal_invoice</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="after">
            <t t-if="l10n_do_fiscal_invoice">
                <div name="company_address">
                    <ul class="list-unstyled">
                        <li t-if="company.is_company_details_empty"><span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/></li>
                        <li t-else=""><span t-field="company.company_details"/></li>
                        <li t-if="not forced_vat and company.vat">
                            <strong>
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label"/>
                                <t t-else="">Tax ID</t>: </strong><span t-field="o.company_id.vat"/>
                        </li>
                        <li t-if="forced_vat">
                            <strong><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: </strong><span t-esc="forced_vat"/>
                        </li>
                    </ul>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'article')]/*[1]" position="before">
            <t t-if="l10n_do_fiscal_invoice">
                <div class="row pt-2 mb8 first-page">
                    <t t-call="l10n_do_accounting.fiscal_info"/>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
