<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            l10n_do_accounting.document_tax_totals_inherit (in the shared
            /home/src/l10n_do_accounting module) adds "Subtotal Gravado" /
            "Subtotal Exento" rows to account.document_tax_totals_template,
            computed from `o.invoice_line_ids`. That template is generic and
            reused (via a "primary" clone) by Sale Order and Purchase Order
            reports, where `o` is either unset or a sale.order/purchase.order
            record with no `invoice_line_ids` field. This crashed every
            Sale/Purchase Order PDF print with a KeyError/AttributeError.

            Fix: only compute these DR-specific subtotals when the record
            being printed is actually an account.move (invoice).
        -->
        <template id="document_tax_totals_gravado_exento_fix" inherit_id="account.document_tax_totals_template">
            <xpath expr="//t[@t-set='l10n_do_subtotal_gravado']" position="attributes">
                <attribute name="t-value">sum(l.price_subtotal for l in o.invoice_line_ids if l.display_type == 'product' and any(t.amount for t in l.tax_ids)) if (o and o._name == 'account.move') else 0</attribute>
            </xpath>
            <xpath expr="//t[@t-set='l10n_do_subtotal_exento']" position="attributes">
                <attribute name="t-value">sum(l.price_subtotal for l in o.invoice_line_ids if l.display_type == 'product' and not any(t.amount for t in l.tax_ids)) if (o and o._name == 'account.move') else 0</attribute>
            </xpath>
        </template>
    </data>
</odoo>
