<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_gti_ecf" model="ir.ui.view">
        <field name="name">account.move.form.gti.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón en el header de la factura. En v19 hay dos <button name="action_post">:
                 el [1] es "Post" (move_type == 'entry', asientos contables) y el [2] es
                 "Confirm" (facturas/notas). "string" no puede usarse como selector de
                 herencia (atributo traducible), por eso se usa xpath con índice. -->
            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button
                    name="action_gti_consultar_estado"
                    string="Consultar Estado GTI"
                    type="object"
                    class="btn-secondary"
                    invisible="state != 'posted' or not gti_ecf_numero"
                />
                <button
                    name="action_gti_reenviar"
                    string="Reenviar a GTI"
                    type="object"
                    class="btn-warning"
                    invisible="state != 'posted' or gti_ecf_state in ('accepted', 'sent')"
                    confirm="¿Desea reenviar esta factura a GTI?"
                />
            </xpath>
            <notebook position="inside">
                <page string="GTI e-CF" name="gti_ecf">
                    <group>
                        <group string="Comprobante Electrónico">
                            <field name="gti_ecf_numero"/>
                            <field name="gti_ecf_state"/>
                            <field name="gti_codigo_seguridad"/>
                            <field name="gti_fecha_firma"/>
                        </group>
                        <group string="Enlace DGII">
                            <field name="gti_url_qr" invisible="not gti_url_qr"/>
                        </group>
                    </group>
                    <group string="Log de Respuestas" invisible="not gti_ecf_response">
                        <field name="gti_ecf_response" nolabel="1" colspan="2"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- List view - agregar estado e-CF -->
    <record id="view_move_list_gti_ecf" model="ir.ui.view">
        <field name="name">account.move.list.gti.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="gti_ecf_state" optional="show" widget="badge"
                    decoration-success="gti_ecf_state == 'accepted'"
                    decoration-warning="gti_ecf_state in ('sent', 'conditional')"
                    decoration-danger="gti_ecf_state in ('rejected', 'error')"
                    decoration-muted="gti_ecf_state == 'pending'"
                />
            </field>
        </field>
    </record>


    <!-- List view facturas de proveedor - agregar estado e-CF -->
    <record id="view_in_invoice_bill_list_gti_ecf" model="ir.ui.view">
        <field name="name">account.move.in.invoice.list.gti.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="gti_ecf_state" optional="show" widget="badge"
                    decoration-success="gti_ecf_state == 'accepted'"
                    decoration-warning="gti_ecf_state in ('sent', 'conditional')"
                    decoration-danger="gti_ecf_state in ('rejected', 'error')"
                    decoration-muted="gti_ecf_state == 'pending'"
                />
            </field>
        </field>
    </record>

    <!-- List view notas de crédito - agregar estado e-CF -->
    <record id="view_out_credit_note_list_gti_ecf" model="ir.ui.view">
        <field name="name">account.move.credit.note.list.gti.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="gti_ecf_state" optional="show" widget="badge"
                    decoration-success="gti_ecf_state == 'accepted'"
                    decoration-warning="gti_ecf_state in ('sent', 'conditional')"
                    decoration-danger="gti_ecf_state in ('rejected', 'error')"
                    decoration-muted="gti_ecf_state == 'pending'"
                />
            </field>
        </field>
    </record>

</odoo>
