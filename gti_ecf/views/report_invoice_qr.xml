<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_invoice_document_gti_qr"
            inherit_id="account.report_invoice_document">
    <xpath expr="//div[@id='right-elements']" position="before">
      <div class="row" t-if="o.gti_url_qr">
        <div class="col-4">
          <img t-att-src="'data:image/png;base64,%s' % o._gti_qr_image()"
               style="width:100px;height:100px;"/>
          <div style="font-size:14px; margin-top:4px;">
            <t t-if="o.gti_codigo_seguridad">
              <strong>Cód. Seguridad: </strong><span t-esc="o.gti_codigo_seguridad"/><br/>
            </t>
            <t t-if="o.gti_fecha_firma">
              <strong>Fecha Firma: </strong><span t-esc="o.gti_fecha_firma"/>
            </t>
          </div>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
