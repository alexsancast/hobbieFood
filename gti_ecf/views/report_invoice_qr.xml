<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_invoice_document_gti_qr"
            inherit_id="account.report_invoice_document">
    <xpath expr="(//div[hasclass('oe_structure')])[last()]" position="before">
      <div class="row" t-if="o.gti_url_qr" style="margin-top: 20px;">
        <div class="col-4">
          <img t-att-src="'data:image/png;base64,%s' % o._gti_qr_image()"
               style="width:100px;height:100px;"/>
          <div style="font-size:14px; margin-top:4px;">
            <div t-if="o.gti_codigo_seguridad" style="white-space: nowrap;">
              <strong>Cód. Seguridad: </strong><span t-esc="o.gti_codigo_seguridad"/>
            </div>
            <div t-if="o.gti_fecha_firma" style="white-space: nowrap;">
              <strong>Fecha Firma: </strong><span t-esc="o.gti_fecha_firma"/>
            </div>
          </div>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
