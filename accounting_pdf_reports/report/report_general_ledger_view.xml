<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="general_ledger_view" name="General Ledger Interactive View">
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>General Ledger</title>
    <t t-call="accounting_pdf_reports.report_styles"/>
    <style>
        .afr-container { max-width: 1400px; }
    </style>
</head>
<body>
<div class="afr-container">

    <!-- Header -->
    <div class="afr-header">
        <h1 class="afr-title">General Ledger</h1>
        <div class="afr-subtitle" t-esc="company.name"/>
        <div class="afr-meta">
            <t t-if="data.get('date_from')">
                <strong>From:</strong> <span t-esc="data['date_from']"/>&#160;&#160;
            </t>
            <t t-if="data.get('date_to')">
                <strong>To:</strong> <span t-esc="data['date_to']"/>&#160;&#160;
            </t>
            <strong>Entries:</strong>
            <span t-if="data.get('target_move') == 'all'">All</span>
            <span t-if="data.get('target_move') == 'posted'">Posted</span>
        </div>
    </div>

    <!-- Filter bar -->
    <form method="GET" t-att-action="apply_url" class="afr-filter-bar">
        <div class="afr-filter-row">
            <t t-call="accounting_pdf_reports.report_filter_bar_common"/>

            <div class="afr-field">
                <label class="afr-label">Display Accounts</label>
                <select name="display_account" class="afr-select">
                    <option value="all"
                            t-att-selected="'selected' if data.get('display_account') == 'all' else None">All</option>
                    <option value="movement"
                            t-att-selected="'selected' if data.get('display_account') == 'movement' else None">With movements</option>
                    <option value="not_zero"
                            t-att-selected="'selected' if data.get('display_account') == 'not_zero' else None">Balance ≠ 0</option>
                </select>
            </div>

            <div class="afr-field">
                <label class="afr-label">Sort by</label>
                <select name="sortby" class="afr-select">
                    <option value="sort_date"
                            t-att-selected="'selected' if data.get('sortby') == 'sort_date' else None">Date</option>
                    <option value="sort_journal_partner"
                            t-att-selected="'selected' if data.get('sortby') == 'sort_journal_partner' else None">Journal &amp; Partner</option>
                </select>
            </div>

            <div class="afr-check">
                <input type="checkbox" class="afr-check-input" id="cb_initial_balance"
                       name="initial_balance" value="1"
                       t-att-checked="'checked' if data.get('initial_balance') else None"/>
                <label class="afr-check-label" for="cb_initial_balance">Initial Balance</label>
            </div>

            <t t-call="accounting_pdf_reports.report_filter_bar_buttons"/>
        </div>
    </form>

    <!-- View-only toolbar -->
    <div class="afr-view-toolbar">
        <button type="button" class="afr-btn afr-btn-outline" onclick="expandAll()">Expand All</button>
        <button type="button" class="afr-btn afr-btn-outline" onclick="collapseAll()">Collapse All</button>
    </div>

    <!-- Accounts -->
    <t t-if="not accounts">
        <div class="afr-ledger-empty">No accounts match the selected filters.</div>
    </t>

    <t t-foreach="accounts" t-as="acc">
        <div class="afr-account-section">
            <div class="afr-account-header"
                 t-att-onclick="'toggleAccount(%d)' % acc_index">
                <span class="o-toggle-icon" t-att-id="'icon-%d' % acc_index">&#9660;</span>
                <span class="afr-account-code" t-esc="acc.get('code')"/>
                <span class="afr-account-name" t-esc="acc.get('name')"/>
                <span class="afr-account-totals">
                    <span class="afr-stat">
                        <span class="afr-stat-label">Debit</span>
                        <span class="afr-stat-value" t-esc="fmt(acc.get('debit'))"/>
                    </span>
                    <span class="afr-stat">
                        <span class="afr-stat-label">Credit</span>
                        <span class="afr-stat-value" t-esc="fmt(acc.get('credit'))"/>
                    </span>
                    <span class="afr-stat">
                        <span class="afr-stat-label">Balance</span>
                        <span class="afr-stat-value" t-esc="fmt(acc.get('balance'))"/>
                    </span>
                </span>
            </div>
            <div t-att-id="'body-%d' % acc_index">
                <table class="afr-ledger-table">
                    <thead>
                        <tr>
                            <th style="width:100px;">Date</th>
                            <th style="width:80px;">Journal</th>
                            <th style="width:130px;">Move</th>
                            <th>Partner</th>
                            <th>Label</th>
                            <th class="afr-text-end" style="width:120px;">Debit</th>
                            <th class="afr-text-end" style="width:120px;">Credit</th>
                            <th class="afr-text-end" style="width:120px;">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="not acc.get('move_lines')">
                            <tr><td colspan="8" class="afr-ledger-empty">No move lines.</td></tr>
                        </t>
                        <tr t-foreach="acc.get('move_lines') or []" t-as="line">
                            <td t-esc="line.get('ldate') or ''"/>
                            <td t-esc="line.get('lcode') or ''"/>
                            <td t-esc="line.get('move_name') or ''"/>
                            <td t-esc="line.get('partner_name') or ''"/>
                            <td t-esc="line.get('lname') or line.get('lref') or ''"/>
                            <td class="afr-text-end" t-esc="fmt(line.get('debit'))"/>
                            <td class="afr-text-end" t-esc="fmt(line.get('credit'))"/>
                            <td class="afr-text-end" t-esc="fmt(line.get('balance'))"/>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</div>

<script>
    var accountStates = {};

    function toggleAccount(id) {
        var body = document.getElementById('body-' + id);
        var icon = document.getElementById('icon-' + id);
        var expanded = accountStates[id] !== false;
        accountStates[id] = !expanded;
        if (body) body.style.display = expanded ? 'none' : '';
        if (icon) {
            if (expanded) icon.classList.add('collapsed');
            else icon.classList.remove('collapsed');
        }
    }

    function expandAll() {
        document.querySelectorAll('[id^="body-"]').forEach(function(el) {
            el.style.display = '';
        });
        document.querySelectorAll('.o-toggle-icon').forEach(function(i) {
            i.classList.remove('collapsed');
        });
        Object.keys(accountStates).forEach(function(k) { accountStates[k] = true; });
    }

    function collapseAll() {
        document.querySelectorAll('[id^="body-"]').forEach(function(el) {
            el.style.display = 'none';
        });
        document.querySelectorAll('.o-toggle-icon').forEach(function(i) {
            i.classList.add('collapsed');
        });
        Object.keys(accountStates).forEach(function(k) { accountStates[k] = false; });
    }

    window.onbeforeprint = expandAll;
</script>
</body>
</html>
</template>

</odoo>
