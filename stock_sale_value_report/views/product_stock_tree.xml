<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="product_product_stock_tree_inherit_sale_value">
            <field name="name">product.product.stock.list.inherit.sale.value</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_product_stock_tree"/>
            <field name="arch" type="xml">
                <field name="total_value" position="after">
                    <field name="lst_price"
                        string="Precio Venta" optional="show" widget="monetary"
                        options="{'currency_field': 'company_currency_id'}"/>
                    <field name="sale_value_total"
                        string="Valor Total" optional="show" widget="monetary"
                        options="{'currency_field': 'company_currency_id'}"
                        sum="Valor Total"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
